@model BiblioCampus.Models.Prestamo
@{
    ViewData["Title"] = "Nuevo Préstamo";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <p class="text-xs text-slate-500">Préstamos / Nuevo Registro</p>
        <h1 class="font-display text-2xl font-bold text-slate-900">Registrar Préstamo</h1>
    </div>

    <form asp-action="Create" method="post" class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label asp-for="FechaPrestamo" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="FechaPrestamo" type="date" class="w-full px-3.5 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
                <span asp-validation-for="FechaPrestamo"></span>
            </div>
            <div>
                <label asp-for="Estado" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <select asp-for="Estado" asp-items="ViewBag.Estados" class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600"></select>
                <span asp-validation-for="Estado"></span>
            </div>
        </div>

        <div>
            <label asp-for="EstudianteId" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <select asp-for="EstudianteId" asp-items="ViewBag.EstudianteId" class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600">
                <option value="">-- Seleccione un estudiante --</option>
            </select>
            <span asp-validation-for="EstudianteId"></span>
        </div>

        <div>
            <label asp-for="LibroId" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <select asp-for="LibroId" asp-items="ViewBag.LibroId" class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600">
                <option value="">-- Seleccione un libro --</option>
            </select>
            <span asp-validation-for="LibroId"></span>
        </div>

        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg">Cancelar</a>
            <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg">Guardar Préstamo</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
