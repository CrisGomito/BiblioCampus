@model BiblioCampus.Models.Prestamo
@{
    ViewData["Title"] = "Eliminar Préstamo";
}

<div class="max-w-xl mx-auto bg-white border border-slate-200 rounded-xl p-6 space-y-5">
    <div>
        <p class="text-xs font-medium text-rose-700">Confirmación de Eliminación</p>
        <h1 class="mt-1 font-display text-xl font-bold text-slate-900">¿Eliminar el préstamo #@Model.Id?</h1>
        <p class="mt-1 text-sm text-slate-600">Se eliminará este registro del historial de préstamos en SQL Server.</p>
    </div>

    <dl class="grid grid-cols-2 gap-4 text-sm border-t border-b border-slate-200 py-4">
        <div>
            <dt class="text-xs text-slate-500">Estudiante</dt>
            <dd class="font-medium text-slate-900">@Model.Estudiante?.NombreCompleto</dd>
        </div>
        <div>
            <dt class="text-xs text-slate-500">Libro</dt>
            <dd class="text-slate-800">@Model.Libro?.Titulo</dd>
        </div>
        <div>
            <dt class="text-xs text-slate-500">Fecha</dt>
            <dd class="font-mono text-slate-800">@Model.FechaPrestamo.ToString("yyyy-MM-dd")</dd>
        </div>
        <div>
            <dt class="text-xs text-slate-500">Estado</dt>
            <dd class="font-semibold text-slate-800">@Model.Estado</dd>
        </div>
    </dl>

    <form asp-action="Delete" method="post" class="flex items-center justify-end gap-3">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg">Cancelar</a>
        <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-rose-700 hover:bg-rose-800 rounded-lg">Eliminar Préstamo</button>
    </form>
</div>
