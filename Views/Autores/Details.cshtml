@model BiblioCampus.Models.Autor
@{
    ViewData["Title"] = "Detalle de Autor";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <p class="text-xs text-slate-500">Autores / Detalle</p>
            <h1 class="font-display text-2xl font-bold text-slate-900">@Model.NombreCompleto</h1>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg">Editar</a>
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg">Volver</a>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
            <div>
                <dt class="text-xs font-medium text-slate-500">ID</dt>
                <dd class="mt-1 font-mono text-slate-900 tabular-nums">@Model.Id</dd>
            </div>
            <div>
                <dt class="text-xs font-medium text-slate-500">@Html.DisplayNameFor(m => m.Nacionalidad)</dt>
                <dd class="mt-1 text-slate-900">@Model.Nacionalidad</dd>
            </div>
            <div>
                <dt class="text-xs font-medium text-slate-500">@Html.DisplayNameFor(m => m.Nombres)</dt>
                <dd class="mt-1 font-medium text-slate-900">@Model.Nombres</dd>
            </div>
            <div>
                <dt class="text-xs font-medium text-slate-500">@Html.DisplayNameFor(m => m.Apellidos)</dt>
                <dd class="mt-1 font-medium text-slate-900">@Model.Apellidos</dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="text-xs font-medium text-slate-500">@Html.DisplayNameFor(m => m.CorreoContacto)</dt>
                <dd class="mt-1 font-mono text-xs text-slate-700">@Model.CorreoContacto</dd>
            </div>
        </dl>

        <div class="border-t border-slate-200 pt-5">
            <h2 class="font-display text-sm font-semibold text-slate-900 mb-3">Obras registradas (@Model.Libros.Count)</h2>
            @if (!Model.Libros.Any())
            {
                <p class="text-xs text-slate-500">Este autor aún no tiene libros registrados en el catálogo.</p>
            }
            else
            {
                <ul class="divide-y divide-slate-100 text-sm">
                    @foreach (var libro in Model.Libros)
                    {
                        <li class="py-2.5 flex items-center justify-between gap-4">
                            <div>
                                <p class="font-medium text-slate-900">@libro.Titulo</p>
                                <p class="text-xs text-slate-500">ISBN: @libro.Isbn · Categoría: @libro.Categoria?.Nombre</p>
                            </div>
                            <a asp-controller="Libros" asp-action="Details" asp-route-id="@libro.Id" class="text-xs font-medium text-blue-700 hover:underline">Ver libro</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
