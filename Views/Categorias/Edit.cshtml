@model BiblioCampus.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <p class="text-xs text-slate-500">Categorías / Edición</p>
        <h1 class="font-display text-2xl font-bold text-slate-900">Editar Categoría</h1>
    </div>

    <form asp-action="Edit" method="post" class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label asp-for="Codigo" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Codigo" class="w-full px-3.5 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
                <span asp-validation-for="Codigo"></span>
            </div>
            <div>
                <label asp-for="UbicacionEstante" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="UbicacionEstante" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
                <span asp-validation-for="UbicacionEstante"></span>
            </div>
        </div>

        <div>
            <label asp-for="Nombre" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <input asp-for="Nombre" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
            <span asp-validation-for="Nombre"></span>
        </div>

        <div>
            <label asp-for="Descripcion" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <textarea asp-for="Descripcion" rows="3" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600"></textarea>
            <span asp-validation-for="Descripcion"></span>
        </div>

        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg">Cancelar</a>
            <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
