@model IEnumerable<BiblioCampus.Models.Estudiante>
@{
    ViewData["Title"] = "Estudiantes";
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <p class="text-xs font-medium text-slate-500">Entidad 4 de 5 · Comunidad Universitaria</p>
        <h1 class="font-display text-2xl font-bold text-slate-900">Estudiantes</h1>
    </div>
    <div class="flex items-center gap-3">
        <input type="search" data-filtro-tabla="tablaEstudiantes" placeholder="Buscar cédula, nombre o carrera..."
               class="w-60 px-3 py-2 text-sm bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
        <a asp-action="Create" class="px-4 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg transition-colors whitespace-nowrap shrink-0">
            Nuevo Estudiante
        </a>
    </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
    <div class="overflow-x-auto">
        <table id="tablaEstudiantes" class="w-full text-left border-collapse text-sm">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
                    <th class="px-6 py-3">Cédula</th>
                    <th class="px-6 py-3">Nombre Completo</th>
                    <th class="px-6 py-3">Correo Electrónico</th>
                    <th class="px-6 py-3">Carrera</th>
                    <th class="px-6 py-3 text-right">Préstamos</th>
                    <th class="px-6 py-3 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <tr data-fila-registro class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-6 py-3.5 font-mono text-xs text-slate-700 tabular-nums whitespace-nowrap">@item.Cedula</td>
                        <td class="px-6 py-3.5 font-medium text-slate-900">@item.NombreCompleto</td>
                        <td class="px-6 py-3.5 font-mono text-xs text-slate-600">@item.CorreoElectronico</td>
                        <td class="px-6 py-3.5 text-slate-600">@item.Carrera</td>
                        <td class="px-6 py-3.5 text-right font-mono text-xs text-slate-700 tabular-nums">@item.Prestamos.Count</td>
                        <td class="px-6 py-3.5 text-right whitespace-nowrap space-x-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-xs font-medium text-slate-600 hover:text-slate-900">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-xs font-medium text-blue-700 hover:text-blue-900">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-xs font-medium text-rose-700 hover:text-rose-900">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr data-fila-sin-resultados class="@(Model.Any() ? "hidden" : "")">
                    <td colspan="6" class="px-6 py-10 text-center text-sm text-slate-500">
                        No se encontraron estudiantes registrados.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
