@model BiblioCampus.Models.Estudiante
@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<div class="max-w-xl mx-auto bg-white border border-slate-200 rounded-xl p-6 space-y-5">
    <div>
        <p class="text-xs font-medium text-rose-700">Confirmación de Eliminación</p>
        <h1 class="mt-1 font-display text-xl font-bold text-slate-900">¿Eliminar a "@Model.NombreCompleto"?</h1>
        <p class="mt-1 text-sm text-slate-600">El registro del estudiante será eliminado permanentemente de SQL Server.</p>
    </div>

    @if (Model.Prestamos.Any())
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs text-amber-900">
            Atención: este estudiante tiene <strong>@Model.Prestamos.Count préstamo(s)</strong> registrado(s). Por integridad referencial (<code class="font-mono">DeleteBehavior.Restrict</code>), primero elimine los préstamos vinculados.
        </div>
    }

    <dl class="grid grid-cols-2 gap-4 text-sm border-t border-b border-slate-200 py-4">
        <div>
            <dt class="text-xs text-slate-500">Cédula</dt>
            <dd class="font-mono text-slate-900">@Model.Cedula</dd>
        </div>
        <div>
            <dt class="text-xs text-slate-500">Carrera</dt>
            <dd class="text-slate-800">@Model.Carrera</dd>
        </div>
    </dl>

    <form asp-action="Delete" method="post" class="flex items-center justify-end gap-3">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg">Cancelar</a>
        <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-rose-700 hover:bg-rose-800 rounded-lg">Eliminar Estudiante</button>
    </form>
</div>
