@model BiblioCampus.Models.Libro
@{
    ViewData["Title"] = "Nuevo Libro";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <p class="text-xs text-slate-500">Libros / Nuevo Registro</p>
        <h1 class="font-display text-2xl font-bold text-slate-900">Registrar Libro</h1>
    </div>

    <form asp-action="Create" method="post" class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Titulo" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <input asp-for="Titulo" placeholder="Ej. Clean Code: Manual de Estilo para Desarrollo Ágil" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
            <span asp-validation-for="Titulo"></span>
        </div>

        <div>
            <label asp-for="Isbn" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <input asp-for="Isbn" placeholder="Ej. 978-0-13-235088-4" class="w-full px-3.5 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" />
            <span asp-validation-for="Isbn"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label asp-for="AutorId" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <select asp-for="AutorId" asp-items="ViewBag.AutorId" class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600">
                    <option value="">-- Seleccione un autor --</option>
                </select>
                <span asp-validation-for="AutorId"></span>
            </div>
            <div>
                <label asp-for="CategoriaId" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600">
                    <option value="">-- Seleccione una categoría --</option>
                </select>
                <span asp-validation-for="CategoriaId"></span>
            </div>
        </div>

        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg">Cancelar</a>
            <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg">Guardar Libro</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
